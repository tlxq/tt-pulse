{
  "name": "tt-pulse-agent",
  "version": "1.1.0",
  "description": "Modular node agent for TT-Pulse monitoring",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "setup": "chmod +x setup.sh && ./setup.sh",
    "update": "git pull && npm install && sudo systemctl restart ttpulse-agent",
    "status": "sudo systemctl status ttpulse-agent",
    "logs": "journalctl -u ttpulse-agent -f"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.1",
    "dotenv": "^16.3.1",
    "systeminformation": "^5.21.22"
  }
}
