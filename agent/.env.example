# TT-Pulse Agent Configuration
# ---------------------------------------------------------

# The unique name of this node (e.g. Toms-Arch, Home-Server)
COMPUTER_NAME=My-Linux-Node

# Path to the directory containing your Git repositories
PROJECTS_PATH=/path/to/your/git/repos

# How often to send heartbeats (in milliseconds). Default: 120000 (2 min)
HEARTBEAT_INTERVAL=120000

# SUPABASE CONNECTION (Required)
# Found in Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
