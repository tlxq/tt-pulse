# TT-Pulse Agent Configuration
COMPUTER_NAME="My-PC-Name"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-key"
HEARTBEAT_INTERVAL=30000

# --- Agent Authentication (NYTT: Krävs för säkerhet!) ---
# Skapa en användare i Supabase -> Authentication -> Users
AGENT_EMAIL="agent@din-doman.se"
AGENT_PASSWORD="password"

# --- Git Tracking Configuration ---

# Option A: Single or multi-path tracking (comma-separated absolute paths)
# GIT_REPO_PATH="/home/user/projects/my-app,/home/user/projects/another-repo"

# Option B: Multi-repo Tracking (Scan a folder for all git repos)
# Set the path to a parent directory and all subdirs with a .git folder will be tracked.
# GIT_PARENT_PATH="~/.1repos/dev"

# Option C: Remote Tracking (GitHub API)
GITHUB_USERNAME="your-github-username"
GITHUB_TOKEN="your-personal-access-token"

# Optional: Filter remote events to a specific repository
# GITHUB_REPO="owner/repo-name"
