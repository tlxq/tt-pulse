# TT-Pulse Agent Configuration
COMPUTER_NAME="My-PC-Name"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-key"
HEARTBEAT_INTERVAL=30000

# --- Git Tracking Configuration ---

# Option A: Local Tracking (Best for tracking specific folders on this PC)
# Set the absolute or relative path to a git repository you want to monitor.
# GIT_REPO_PATH="/home/user/projects/my-app"

# Option B: Remote Tracking (GitHub API)
GITHUB_USERNAME="your-github-username"
GITHUB_TOKEN="your-personal-access-token"

# Optional: Filter remote events to a specific repository
# GITHUB_REPO="owner/repo-name"
